# CONFIG DATABASE
DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dalia_cakes_db
DB_USER=postgres
DOCKER_DB_URL=
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dalia_cakes_db

# CONFIG DATABASE TO ALEMBIC
ALEMBIC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dalia_cakes_db


# INSTAGRAM CONFIG
# Long-lived token (valid for 60 days). The app refreshes it automatically every 50 days.
# Generate via Meta for Developers: https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_access_token


# CHATBOT CONFIG
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key
BUSINESS_NAME=your_business_name
BUSINESS_PHONE=your_business_phone
BUSINESS_ADDRESS=your_business_address
BUSINESS_CITY=your_business_city
BUSINESS_HOURS=your_business_hours
BUSINESS_PAYMENT_METHODS=your_business_payment_methods
BUSINESS_IFOOD_LINK=your_business_ifood_link
BUSINESS_RECIPES_URL=your_business_recipes_url
BUSINESS_CAKE_PRICE_PER_KG=your_business_cake_price_per_kg
BUSINESS_ORDER_ADVANCE_DAYS=your_business_order_advance_days


# AWS S3 CONFIG
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name
AWS_S3_REGION=your_s3_region

# SYSTEM OWNER (created automatically on first startup)
OWNER_USERNAME=owner
OWNER_PASSWORD=ChangeMe@2026
OWNER_EMAIL=owner@dalia_cakes.com
OWNER_FIRST_NAME=System
OWNER_LAST_NAME=Owner



# ENVIRONMENT
# Options: development, production
# In development: Swagger UI (/docs), ReDoc (/redoc) and OpenAPI (/openapi.json) are enabled
# In production: all API documentation endpoints are disabled automatically
ENV=development


# CONFIG JWT
# Generate a strong secret key: openssl rand -hex 32

SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# NAME API AND VERSION
API_TITLE=dalia cakes API
API_VERSION=1.0.0
API_V1_PREFIX=/api/v1



# CONFIG LOGGING
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# In production, use INFO or WARNING to reduce log verbosity
LOG_LEVEL=DEBUG

# Options: text, json
# In production, use JSON for better log parsing and analysis
LOG_FORMAT=text


# FRONTEND BUILD VARS (used by docker-compose build args)
# In production VITE_API_URL should be /api/v1 (nginx proxies /api/ to backend)
VITE_API_URL=/api/v1
VITE_BUSINESS_PHONE=your_business_phone
VITE_WHATSAPP_NUMBER=your_whatsapp_number_digits_only
VITE_IFOOD_URL=your_ifood_url
VITE_ADDRESS=your_address
VITE_MAPS_LINK=your_google_maps_link
VITE_MAPS_EMBED=your_google_maps_embed_url
