# ─── Stage 1: builder ────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# VITE_ vars are baked into the bundle at build time
ARG VITE_API_URL=/api/v1
ARG VITE_BUSINESS_PHONE
ARG VITE_WHATSAPP_NUMBER
ARG VITE_IFOOD_URL
ARG VITE_ADDRESS
ARG VITE_MAPS_LINK
ARG VITE_MAPS_EMBED

ENV VITE_API_URL=$VITE_API_URL \
    VITE_BUSINESS_PHONE=$VITE_BUSINESS_PHONE \
    VITE_WHATSAPP_NUMBER=$VITE_WHATSAPP_NUMBER \
    VITE_IFOOD_URL=$VITE_IFOOD_URL \
    VITE_ADDRESS=$VITE_ADDRESS \
    VITE_MAPS_LINK=$VITE_MAPS_LINK \
    VITE_MAPS_EMBED=$VITE_MAPS_EMBED

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

# ─── Stage 2: runtime ────────────────────────────────────────────────────────
FROM nginx:alpine AS runtime

COPY --from=builder /app/dist /usr/share/nginx/html

# Configuração para React Router funcionar
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
