# ─── Stage 1: builder ────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# VITE_ vars are baked into the bundle at build time
ARG VITE_API_URL=/api/v1
ARG VITE_BUSINESS_PHONE="+55 11 995469412"
ARG VITE_WHATSAPP_NUMBER="5511995469412"
ARG VITE_IFOOD_URL="https://www.ifood.com.br/delivery/sao-paulo-sp/confeitaria-dalia-bolos-e-sobremesas-vila-fernandes/8aa01342-582c-46f4-bec7-37faf062f735"
ARG VITE_INSTAGRAM_URL="https://www.instagram.com/confeitariadadalia/"
ARG VITE_FACEBOOK_URL="https://www.facebook.com/enidalia.moreira"
ARG VITE_ADDRESS="Rua Vacanga, 41 - Vila Fernandes, São Paulo - SP"
ARG VITE_MAPS_LINK="https://maps.google.com/?q=Rua+Vacanga+41+Vila+Fernandes+São+Paulo+SP"
ARG VITE_MAPS_EMBED="https://maps.google.com/maps?q=Rua+Vacanga+41+Vila+Fernandes+São+Paulo+SP&output=embed"

ENV VITE_API_URL=$VITE_API_URL \
    VITE_BUSINESS_PHONE=$VITE_BUSINESS_PHONE \
    VITE_WHATSAPP_NUMBER=$VITE_WHATSAPP_NUMBER \
    VITE_IFOOD_URL=$VITE_IFOOD_URL \
    VITE_INSTAGRAM_URL=$VITE_INSTAGRAM_URL \
    VITE_FACEBOOK_URL=$VITE_FACEBOOK_URL \
    VITE_ADDRESS=$VITE_ADDRESS \
    VITE_MAPS_LINK=$VITE_MAPS_LINK \
    VITE_MAPS_EMBED=$VITE_MAPS_EMBED

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

# ─── Stage 2: runtime ────────────────────────────────────────────────────────
FROM nginx:alpine AS runtime

COPY --from=builder /app/dist /usr/share/nginx/html

# Configuração para React Router funcionar
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
